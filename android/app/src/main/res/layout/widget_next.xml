<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <ImageView
        android:id="@+id/w_title"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:adjustViewBounds="true"
        android:contentDescription="후기씨앗"
        android:scaleType="fitStart" />

    <ImageView
        android:id="@+id/w_sub"
        android:layout_width="wrap_content"
        android:layout_height="15dp"
        android:layout_marginTop="4dp"
        android:adjustViewBounds="true"
        android:contentDescription="요약"
        android:scaleType="fitStart" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_btn1"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn"
            android:contentDescription="링크로 시작"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:scaleType="centerInside" />

        <FrameLayout
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <ImageView
            android:id="@+id/w_btn2"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_primary"
            android:contentDescription="현장 메모"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:scaleType="centerInside" />
    </LinearLayout>
</LinearLayout>
