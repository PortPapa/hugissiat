<?xml version="1.0" encoding="utf-8"?>
<!-- 갈 곳 일정 위젯: 방문 날짜가 정해진 곳 최대 3개 + 미정 + 버튼 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/w_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="갈 곳"
        android:textColor="#1F1F1F"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout android:id="@+id/r1" style="@style/WRow">
        <TextView android:id="@+id/r1_day" style="@style/WDay" />
        <LinearLayout style="@style/WCol">
            <TextView android:id="@+id/r1_name" style="@style/WName" />
            <TextView android:id="@+id/r1_sub" style="@style/WSub" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/r2" style="@style/WRow">
        <TextView android:id="@+id/r2_day" style="@style/WDay" />
        <LinearLayout style="@style/WCol">
            <TextView android:id="@+id/r2_name" style="@style/WName" />
            <TextView android:id="@+id/r2_sub" style="@style/WSub" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/r3" style="@style/WRow">
        <TextView android:id="@+id/r3_day" style="@style/WDay" />
        <LinearLayout style="@style/WCol">
            <TextView android:id="@+id/r3_name" style="@style/WName" />
            <TextView android:id="@+id/r3_sub" style="@style/WSub" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/w_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="정해진 방문 일정이 없어요"
        android:textColor="#6F6A62"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/w_tbd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#6F6A62"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_btn1"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn"
            android:gravity="center"
            android:text="추가"
            android:textColor="#1F1F1F"
            android:textSize="13sp"
            android:textStyle="bold" />

        <View
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/w_btn2"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_primary"
            android:gravity="center"
            android:text="현장 메모"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
