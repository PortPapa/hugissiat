<?xml version="1.0" encoding="utf-8"?>
<!-- 갈 곳 일정 위젯: 이번 달 캘린더에 방문 날짜 표시 + 미정 개수 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="갈 곳"
            android:textColor="#2E3A2D"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_tbd"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/widget_btn_blush"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="#9C5A70"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_add"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_btn_primary"
            android:gravity="center"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/w_cal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:contentDescription="이번 달 방문 일정"
        android:scaleType="fitCenter" />
</LinearLayout>