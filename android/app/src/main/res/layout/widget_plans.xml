<?xml version="1.0" encoding="utf-8"?>
<!-- 갈 곳 일정 위젯: 이번 달 캘린더에 방문 날짜 표시 + 미정 개수. 글자는 프리젠테이션 글꼴 그림 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_title"
            android:layout_width="wrap_content"
            android:layout_height="19dp"
            android:adjustViewBounds="true"
            android:contentDescription="갈 곳"
            android:scaleType="fitStart" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/w_tbd"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:adjustViewBounds="true"
            android:background="@drawable/widget_btn_blush"
            android:contentDescription="미정"
            android:paddingStart="10dp"
            android:paddingTop="7dp"
            android:paddingEnd="10dp"
            android:paddingBottom="7dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/w_add"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_btn_primary"
            android:gravity="center"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/w_cal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:contentDescription="이번 달 방문 일정"
        android:scaleType="fitCenter" />

    <ImageView
        android:id="@+id/w_next"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginTop="8dp"
        android:adjustViewBounds="true"
        android:contentDescription="다음 일정"
        android:scaleType="fitStart"
        android:visibility="gone" />
</LinearLayout>
